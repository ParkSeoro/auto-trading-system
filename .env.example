# ============================================================
#  Crypto Auto-Trading System - Environment Config
# ============================================================

# Active exchange: bithumb (default) or upbit
EXCHANGE=bithumb

# --- Bithumb API credentials (get from https://www.bithumb.com/u1/US127) ---
BITHUMB_API_KEY=your_api_key_here
BITHUMB_SECRET_KEY=your_secret_key_here

# --- (Optional) Upbit credentials, used only if EXCHANGE=upbit ---
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Trading mode: paper | live
TRADING_MODE=paper

# Paper trading virtual capital (KRW)
PAPER_CAPITAL=1000000

# Risk settings
MAX_POSITION_PCT=0.20          # max % of capital per single position
STOP_LOSS_ATR_MULT=2.0         # stop-loss = entry - ATR * this
TAKE_PROFIT_ATR_MULT=3.0
MAX_DAILY_DRAWDOWN=0.05        # kill switch if drawdown exceeds this

# Bot loop interval (seconds)
LOOP_INTERVAL=60

# Exchange-specific fee/min-order overrides (optional)
# Bithumb standard taker fee is 0.25%; with API coupon applied it can be 0.04%.
BITHUMB_FEE_RATE=0.0025
BITHUMB_MIN_ORDER_KRW=1000
UPBIT_FEE_RATE=0.0005
UPBIT_MIN_ORDER_KRW=5000

# Optional: Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# Log level
LOG_LEVEL=INFO
